void drawPowerOff() {
  spr.setTextColor(C_WHITE);
  spr.setTextSize(2);
  centered("POWER", 10);
  centered("OFF?", 28);

  spr.setTextSize(1);
  spr.setTextColor(C_GREY);
  centered("UP/DN + SEL", 52);

  spr.setTextSize(2);
  const char* labels[2] = {"NO", "YES"};
  for (int i = 0; i < 2; i++) {
    bool sel = (i == 0) ? !powerYes : powerYes;
    int y = 66 + i * 26;
    if (sel) spr.drawRect(30, y, 68, 22, C_YELLOW);
    spr.setTextColor(sel ? C_YELLOW : C_WHITE);
    centered(labels[i], y + 4);
  }
}

void draw() {
  spr.fillSprite(C_BLACK);
  spr.drawRect(0, 0, 128, 128, C_WHITE);
  if (screen == SCR_HOME) {
    if (diag) drawDiag();
    else drawHome();
  } else if (screen == SCR_STOPWATCH) {
    drawStopwatch();
  } else if (screen == SCR_SETTIME) {
    drawSetTime();
  } else {
    drawPowerOff();
  }
  spr.pushSprite(0, 0);
}

void drawNotice(const char* a, const char* b) {
  spr.fillSprite(C_BLACK);
  spr.drawRect(0, 0, 128, 128, C_WHITE);
  spr.setTextColor(C_WHITE);
  spr.setTextSize(2);
  centered(a, 42);
  centered(b, 64);
  spr.pushSprite(0, 0);
}

void lowBatterySleep() {
  swStop();

  setBacklight(BACKLIGHT_LEVEL);
  spr.fillSprite(C_BLACK);
  spr.drawRect(0, 0, 128, 128, C_WHITE);
  spr.setTextColor(C_WHITE);
  spr.setTextSize(2);
  centered("LOW", 36);
  centered("BATTERY", 58);
  spr.setTextSize(1);
  spr.setTextColor(C_GREY);
  centered("PLUG IN TO CHARGE", 94);
  spr.pushSprite(0, 0);
  delay(3000);

  lcd.sleep();
  ledcDetach(PIN_BL);
  pinMode(PIN_BL, OUTPUT);
  digitalWrite(PIN_BL, HIGH);               // active low, so HIGH means backlight off

  gpio_wakeup_enable((gpio_num_t)PIN_USB, GPIO_INTR_HIGH_LEVEL);
  esp_sleep_enable_gpio_wakeup();
  while (!usbPlugged()) {
    esp_light_sleep_start();
  }
  gpio_wakeup_disable((gpio_num_t)PIN_USB);

  ledcAttach(PIN_BL, 20000, 8);
  setBacklight(0);
  lcd.wakeup();
  delay(150);

  updateCharging(true);
  battMv = -1;
  lowSince = 0;
  screenOff = false;
  lastActivity = millis();
  draw();
  setBacklight(BACKLIGHT_LEVEL);
}

void powerOff() {
  if (usbPlugged()) {                       // USB keeps the board powered, so a hard off cannot work
    drawNotice("UNPLUG", "USB FIRST");
    delay(2000);
    screen = screenBeforePower;
    dirty = true;
    return;
  }

  swStop();
  drawNotice("POWERING", "OFF");
  delay(1200);
  setBacklight(0);
  lcd.sleep();

  // Same sequence as stock's shutdown: level low first, then switch the pin to output.
  gpio_set_level((gpio_num_t)PIN_PWDN, 0);
  gpio_config_t cfg = {};
  cfg.pin_bit_mask = 1ULL << PIN_PWDN;
  cfg.mode = GPIO_MODE_OUTPUT;
  gpio_config(&cfg);

  delay(2000);                              // if power cut, the code never gets past here

  // Still running, so the cut did not take effect. Put the pin back the way stock's
  // bootloader leaves it, then wait in light sleep for ALT and restart cleanly.
  gpio_set_direction((gpio_num_t)PIN_PWDN, GPIO_MODE_INPUT);
  gpio_set_pull_mode((gpio_num_t)PIN_PWDN, GPIO_FLOATING);
  ledcDetach(PIN_BL);
  pinMode(PIN_BL, OUTPUT);
  digitalWrite(PIN_BL, HIGH);
  while (digitalRead(BTN_ALT) == HIGH) delay(10);
  gpio_wakeup_enable((gpio_num_t)BTN_ALT, GPIO_INTR_HIGH_LEVEL);
  esp_sleep_enable_gpio_wakeup();
  esp_light_sleep_start();
  ESP.restart();
}

void checkLowBattery() {
  if (chargeState != CS_UNPLUGGED || battMv < 0 || battPct > LOW_BATT_PCT) {
    lowSince = 0;
    return;
  }
  unsigned long now = millis();
  if (lowSince == 0) lowSince = now;
  else if (now - lowSince >= LOW_BATT_HOLD_MS) lowBatterySleep();
}

void handleAlt() {
  if (btnAlt.held && !altHoldFired && screen != SCR_POWEROFF && btnAlt.heldMs() >= POWER_HOLD_MS) {
    altHoldFired = true;
    screenBeforePower = screen;
    screen = SCR_POWEROFF;
    powerYes = false;                       // NO is selected by default
    powerPromptSince = millis();
    dirty = true;
  }

  if (btnAlt.released) {
    if (!altHoldFired && !altIgnoreRelease) {
      if (screen == SCR_POWEROFF) {
        screen = screenBeforePower;         // short ALT press cancels the prompt
      } else {
        diag = false;
        screen = (screen + 1) % 3;
        if (screen == SCR_SETTIME) enterSetTime();
      }
      dirty = true;
    }
    altHoldFired = false;
    altIgnoreRelease = false;
  }
}

void handleButtons() {
  if (screen == SCR_HOME) {
    if (btnSel.pressed) {
      diag = !diag;
      dirty = true;
    }
  } else if (screen == SCR_STOPWATCH) {
    if (btnUp.pressed) {
      if (swRunning) {
        swStop();
      } else {
        swBanked = 0;
        swStartNow();
      }
    }
    if (btnDown.pressed) {
      if (swRunning) swStop();
      else swStartNow();
    }
    if (btnSel.pressed) {
      swRunning = false;
      swBanked = 0;
    }
    if (btnUp.pressed || btnDown.pressed || btnSel.pressed) dirty = true;
  } else if (screen == SCR_SETTIME) {
    if (btnUp.repeat) adjustField(+1);
    if (btnDown.repeat) adjustField(-1);
    if (btnSel.pressed) nextField();
    if (btnUp.repeat || btnDown.repeat || btnSel.pressed) dirty = true;
  } else if (screen == SCR_POWEROFF) {
    if (btnUp.pressed || btnDown.pressed) {
      powerYes = !powerYes;
      powerPromptSince = millis();
      dirty = true;
    }
    if (btnSel.pressed) {
      if (powerYes) {
        powerOff();
      } else {
        screen = screenBeforePower;
        dirty = true;
      }
    }
  }
}

void setup() {
  ledsOff();

  pinMode(BTN_UP, INPUT_PULLDOWN);
  pinMode(BTN_DOWN, INPUT_PULLDOWN);
  pinMode(BTN_SELECT, INPUT_PULLDOWN);
  pinMode(BTN_ALT, INPUT_PULLDOWN);
  pinMode(PIN_USB, INPUT);
  pinMode(PIN_CHRG, INPUT);

  ledcAttach(PIN_BL, 20000, 8);
  setBacklight(0);                          // stay dark until the first frame is ready

  analogSetPinAttenuation(PIN_BATT, ADC_2_5db);
  Wire.begin(PIN_SDA, PIN_SCL);

  hwRev = esp_efuse_read_reg(EFUSE_BLK3, 1) & 0xFF;
  lcd.configure(hwRev >= 3);
  lcd.init();
  lcd.fillScreen(C_BLACK);

  spr.setColorDepth(16);
  spr.createSprite(128, 128);

  RtcTime t;
  if (rtcRead(t)) {
    cur = t;
    rtcOk = true;
  }

  updateCharging(true);
  calibrateBattery();
  sampleBattery();

  lastActivity = millis();
  draw();
  dirty = false;
  setBacklight(BACKLIGHT_LEVEL);
}

void loop() {
  unsigned long now = millis();

  btnUp.update();
  btnDown.update();
  btnSel.update();
  btnAlt.update();
  bool any = btnUp.pressed || btnDown.pressed || btnSel.pressed || btnAlt.pressed;

  bool swallow = false;
  if (any) {
    lastActivity = now;
    if (screenOff) {
      setBacklight(BACKLIGHT_LEVEL);
      screenOff = false;
      dirty = true;
      swallow = true;                       // the waking press does nothing else
    }
  }
  if (swallow && btnAlt.pressed) altIgnoreRelease = true;
  handleAlt();
  if (!swallow) handleButtons();

  updateCharging(false);

  if (screen == SCR_POWEROFF && now - powerPromptSince > POWER_PROMPT_MS) {
    screen = screenBeforePower;
    dirty = true;
  }

  if (now - lastRtc >= 250) {
    lastRtc = now;
    RtcTime t;
    rtcOk = rtcRead(t);
    if (rtcOk) {
      bool changed = (t.s != cur.s);
      cur = t;
      if (changed && screen == SCR_HOME) dirty = true;
    }
  }

  if (now - lastBatt >= 2000) {
    lastBatt = now;
    sampleBattery();
    checkLowBattery();                      // can sleep for a long time, so refresh the clock after it
    if (screen == SCR_HOME) dirty = true;
    now = millis();
  }

  if (screen == SCR_STOPWATCH && swRunning) {
    unsigned long tenths = swTotal() / 100;
    if (tenths != lastTenths) {
      lastTenths = tenths;
      dirty = true;
    }
  }

  bool keepOn = (screen == SCR_STOPWATCH && swRunning) || screen == SCR_SETTIME || screen == SCR_POWEROFF;
  if (SCREEN_TIMEOUT_MS > 0 && !screenOff && !keepOn && now - lastActivity > SCREEN_TIMEOUT_MS) {
    setBacklight(0);
    screenOff = true;
  }

  if (dirty && !screenOff) {
    draw();
    dirty = false;
  }

  delay(20);
}
